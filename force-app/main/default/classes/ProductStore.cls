public class ProductStore {
    public string code;
    public string name;
    public integer price;
    public integer stock;
    public decimal discount;
    public Productstore(string code,string name,integer price,integer stock,decimal discount){
        this.code=code;
        this.name=name;
        this.price=price;
        this.stock=stock;
        this.discount=discount;
    }
    

}